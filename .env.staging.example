# ──────────────────────────────────────────────────────────────────────────────
# .env.staging.example
#
# Copier ce fichier en .env.staging pour un test local en mode staging.
# En production Coolify, ces valeurs sont saisies dans l'UI (jamais commitées).
# ──────────────────────────────────────────────────────────────────────────────

# ── Build-time (injecté dans le bundle JS par Vite) ──────────────────────────
# URL de l'API backend au moment du build (utilisée par Vite dev proxy)
VITE_API_URL=https://api-staging.mon-etude-de-sol.fr

# ── Runtime (injecté dans Nginx via docker-entrypoint.sh) ────────────────────
# URL du backend que Nginx utilisera comme proxy_pass côté serveur
# En Coolify : utiliser le nom du service Docker interne (ex: geoconnect-backend)
BACKEND_URL=http://geoconnect-backend-staging:8080

# ── Docker Compose (développement local uniquement) ──────────────────────────
FRONTEND_PORT=3001

